# Copy to .dev.vars for local `npm run preview` (Wrangler).
# In Cloudflare dashboard: Workers & Pages → havensnus → Settings → Variables and Secrets.

NEXTJS_ENV=development

NEXT_PUBLIC_SITE_URL=https://havensnus.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

NEXT_PUBLIC_TAWK_SRC=

# Only needed for `npm run import` (runs locally, not on Cloudflare)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
