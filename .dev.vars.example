# Copy to .dev.vars for local `npm run preview` (Wrangler).
# In Cloudflare dashboard: Workers & Pages → inflatables → Settings → Variables and Secrets.

NEXTJS_ENV=development

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
