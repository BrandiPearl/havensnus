{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "havensnus",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Keep variables set in the Cloudflare dashboard across deploys.
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "havensnus"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // ISR page cache. Shares the product image bucket; entries live under the
  // `incremental-cache/` prefix, apart from `products/`.
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "havensnusbucket"
    }
  ],
  // v1 created the DO-backed ISR queue and tag cache. They exhausted the free
  // plan's 100k Durable Object requests/day, so v2 removes them (see open-next.config.ts).
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["DOQueueHandler", "DOShardedTagCache"]
    }
  ]
}
